# Generated by build/build_site.py — Cloudflare Pages builds this, don't commit it
site/

# Generated PDFs are committed (see formats/print) because Cloudflare's build
# image has no wkhtmltopdf or WeasyPrint fonts. Regenerate locally, then commit.
# The intermediate .html weasyprint renders from is a pure build byproduct,
# never referenced by the site — only the .pdf next to it matters.
/formats/print/*.html

# Python
__pycache__/
*.pyc
.venv/
venv/

# Intermediate state for build/learn_from_edits.py -- EDITORIAL_LEARNED_
# PATTERNS.md (committed) is the human-facing output this regenerates from.
/build/.editorial_learned_state.json

# OS noise
.DS_Store
Thumbs.db
*.swp

# Scratch
/_quarantine/
/tmp/

# Local-only source zips, not part of the repo
/_archive/

# Local secrets (e.g. ELEVENLABS_API_KEY) for running build scripts by
# hand. Never committed. See DEPLOY.md for how this is loaded.
.env.local

# Full-resolution originals for hero photos (assets/photos/web/ is the
# resized, web-ready set that's actually committed and deployed — the
# source/ originals are 100+MB and only needed if a photo ever needs
# re-cropping). See assets/photos/manifest.json for sourcing/license info.
/assets/photos/source/
